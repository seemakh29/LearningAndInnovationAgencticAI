class AgentState(TypedDict):
    messages: Annotated[list[AnyMessage], operator.add]

class Agent:

    def __init__(self, model, system = "", messages = []):
        self.system = system  #saving system message
          # Define the tools within the class
        self.messages = messages
        tools = [self.multiply, self.factorial]
        graph = StateGraph(AgentState)
        graph.add_edge(START, "math_llm")
        graph.add_node("tools", ToolNode(tools))
        graph.add_edge("math_llm", END)
       # graph.add_node("llm", self.llm)
        
        # graph.add_node("add_action", self.add)
        # graph.add_conditional_edges("llm", self.condition,  {True : "add_action", False: END})
        # graph.add_edge("add_action", "llm")
        # graph.set_entry_point("llm")
        self.graph = graph.compile()
        display(Image(self.graph.get_graph().draw_mermaid_png()))

    def llm(self, state: AgentState):
         return "hello"

    def add(self, state: AgentState):
         return "add"

    def condition(self, state: AgentState):
         return True
    
    @staticmethod
    def factorial(n : int)  -> int :
          """
        Calculate the factorial of a number.

        Args:
            n (int): The number to calculate the factorial for.

        Returns:
            int: The factorial of the number.
        """
          return n * (n - 1) if n else 1

    @staticmethod
    def multiply(a: int, b: int) -> int :
          """
        Multiply two numbers.

        Args:
            a (int): The first number.
            b (int): The second number.

        Returns:
            int: The product of the two numbers.
        """
          return a*b
    
    def math_llm(state) -> str: 
        agent = Agent(chat, system="You are a helpful math assistant that explains what it does.")
        # Define the tools to be used
        tools = [agent.multiply, agent.factorial]

        # Bind the tools to the chat model
        model_with_tools = chat.bind_tools(tools)

        # Define the system message content
        msg_content = "Multiply two numbers 5 and 10"
        state = { "message" :  [HumanMessage(msg_content)]}

        # Combine the system message with the existing state messages
        message = [SystemMessage(content=agent.system)] + state['message']

        # Invoke the model with the prepared message
        response = model_with_tools.invoke(message)

        # Print the response
        print(response)




